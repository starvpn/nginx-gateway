#!/command/with-contenv sh

if [ -n "${TZ}" ]; then
    echo "Timezone: ${TZ}"
    ln -sf "/usr/share/zoneinfo/${TZ}" /etc/localtime && \
    echo "${TZ}" > /etc/timezone
fi

# The bundled runtime is OpenResty, but the image keeps a nginx-compatible
# command and /etc/nginx layout so existing settings, volumes, and reload
# commands continue to work.
nginx -g "daemon off;"
